<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:fitsSystemWindows="true"
    tools:context=".activity.LinearMotorActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@color/colorPrimary">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linear motor test (cmd=0x83)"
            android:textSize="18sp"
            android:layout_centerInParent="true"
            android:textColor="@color/white"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Output"
        android:scrollbars="vertical"
        android:padding="10dp"
        android:lineSpacingExtra="5dp"
        android:textSize="16sp"
        android:textColor="@color/colorPrimaryDark"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <!-- 振动配置动态行容器（限高，内部滚动） -->
            <ScrollView
                android:id="@+id/sv_vibration_config_rows"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="5dp"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/ll_vibration_config_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- 添加配置行按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_add_vibration_config_row"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="+ Add config (max 20)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state" />
            </LinearLayout>

            <!-- 振动配置按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_get_vibration_config"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Read vibration config (0x06)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_set_vibration_config"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Set vibration config (0x07)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 立即振动 / 停止振动 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_immediate_vibration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Vibrate now (0x04)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_stop_vibration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stop vibration (0x05)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 目标值输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_target_value"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="uint32_t"
                    android:text="500"
                    android:inputType="number"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 目标值按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_get_target"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Read target (0x08)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_set_target"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Set target (0x09)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 计数值 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_get_count"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Read count (0x0A)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_clear_count"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Clear count (0x0B)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 计数值监听 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_set_count_listener"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Listen for count"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 按配置振动（光之萤火）：配置下标输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Config index n:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_vibration_config_index"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Vibrate with config n"
                    android:text="0"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interval (12~100):"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_min_count_interval"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="12~100"
                    android:text="12"
                    android:inputType="number"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 按配置立即振动 / 停止振动（0x0C/0x0D）-光之萤火 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_immediate_vibration_by_config"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Vibrate now by config (0x0C)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_stop_vibration_by_config"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stop vibration (0x0D)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 最小计数间隔（0x0E/0x0F）-光之萤火 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_set_min_count_interval"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Set min count interval (0x0E)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_get_min_count_interval"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Read min count interval (0x0F)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
