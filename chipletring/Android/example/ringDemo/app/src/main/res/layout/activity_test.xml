<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:background="#F4F5FA" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
 android:background="#191F48" android:paddingStart="20dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:gravity="center_vertical">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ring test" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smriti · health + voice ring" android:textSize="13sp" android:textColor="#AEB4D6"/>
 </LinearLayout><TextView android:id="@+id/tv_connect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reconnect"
  android:textSize="13sp" android:textColor="#FFFFFF" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp"
  android:background="@drawable/sm_btn_primary"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.42" android:orientation="vertical"
 android:background="@drawable/sm_card" android:layout_margin="12dp" android:padding="12dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
  android:textColor="#7A8199" android:text="OUTPUT  ·  press and hold to share"/>
 <TextView android:id="@+id/tv_result" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="6dp"
  android:scrollbars="vertical" android:fontFamily="monospace" android:textSize="12.5sp" android:lineSpacingExtra="3dp" android:textColor="#1E2350"
  android:text="Ready."/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.58">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginStart="6dp"
 android:textSize="12sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="#5A6180" android:text="DEVICE"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:textColor="#7A8199" android:text="Start here. Capabilities shows what this ring can do."/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_app_connect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn_primary" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#FFFFFF" android:text="Capabilities"/><Button android:id="@+id/bt_soft_version" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Firmware"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_hardware_version" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Hardware"/><Button android:id="@+id/bt_battery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Battery"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_battery_state" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Charging"/><Button android:id="@+id/bt_sync_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Sync time"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_read_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Read time"/><View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:layout_margin="5dp"/></LinearLayout>
</LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginStart="6dp"
 android:textSize="12sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="#5A6180" android:text="MEASURE NOW"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:textColor="#7A8199" android:text="Wear the ring and keep your hand still for about 30 seconds."/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_heart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Heart rate"/><Button android:id="@+id/bt_blood_oxygen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Blood oxygen"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_test_temp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Temperature"/><Button android:id="@+id/bt_step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Steps"/></LinearLayout>
</LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginStart="6dp"
 android:textSize="12sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="#5A6180" android:text="STORED DATA"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:textColor="#7A8199" android:text="What the ring recorded on its own."/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_read_log" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Read all history"/><Button android:id="@+id/btn_getCollection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Measure interval"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/bt_getSn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Serial number"/><Button android:id="@+id/bt_getBluttoothName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#1E2350" android:text="Bluetooth name"/></LinearLayout>
</LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginStart="6dp"
 android:textSize="12sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="#5A6180" android:text="MORE"/>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<Button android:id="@+id/bt_get_page2" android:layout_width="match_parent"  android:layout_height="52dp" android:layout_margin="5dp"
 android:background="@drawable/sm_btn_primary" android:stateListAnimator="@null" android:textAllCaps="false" android:textSize="15sp"
 android:textColor="#FFFFFF" android:text="Voice recording &amp; raw sensors  →"/>
</LinearLayout>
<!-- Vendor controls we never use (dangerous, cloud, or irrelevant). Kept only because the code looks them up. -->
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:orientation="vertical"><Button android:id="@+id/bt_app_bind" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_app_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_clear_step" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_setSn" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_collection_period" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_setCollection" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_bluetooth_name" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_setBluttoothName" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_gomore_age" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_gomore_sex" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_gomore_height" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/et_gomore_weight" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_gomore_user" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_get_gomore_user" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_gomore_test" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/btn_ota" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_linear_motor" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_new_protocol" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/bt_touch_setting" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
</ScrollView>
</LinearLayout>
